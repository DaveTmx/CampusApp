<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:paddingLeft="28dp"
    android:paddingRight="28dp">

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_profile"
        android:background="@drawable/bg_pill_selected"
        android:padding="20dp"
        android:contentDescription="Mulungushi University crest"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Campus Companion"
        android:textColor="@color/text_dark"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Mulungushi University"
        android:textColor="@color/text_gray"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/btnStudent"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_button_blue"
        android:text="I'm a Student"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="0dp"/>

    <Button
        android:id="@+id/btnLecturer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_red"
        android:text="I'm a Lecturer"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="0dp"/>

    <TextView
        android:id="@+id/btnGuest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Continue as guest"
        android:textColor="@color/primary_blue"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

    <View
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_progress_fill_navy"/>

</LinearLayout>
