<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout style="@style/SectionHeader">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedule"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Timetable &amp; class sessions"
            android:textColor="#B9C6DA"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">
        <TextView android:id="@+id/tabMon" style="@style/DayTab" android:text="Mon"/>
        <TextView android:id="@+id/tabTue" style="@style/DayTab" android:text="Tue"/>
        <TextView android:id="@+id/tabWed" style="@style/DayTab" android:text="Wed"/>
        <TextView android:id="@+id/tabThu" style="@style/DayTab" android:text="Thu"/>
        <TextView android:id="@+id/tabFri" style="@style/DayTab" android:text="Fri"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/classesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" android:id="@+id/bottomNavInclude"/>

</LinearLayout>
