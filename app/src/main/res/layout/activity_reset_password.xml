<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_back"
        app:tint="@color/text_dark"
        android:layout_marginBottom="16dp"
        android:contentDescription="Back"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="24dp"
        android:text="Enter your email to receive a security OTP"
        android:textColor="@color/text_gray"
        android:textSize="14sp"/>

    <!-- Step 1: Email Input -->
    <LinearLayout
        android:id="@+id/layoutEmailStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView style="@style/InputLabel" android:text="Email Address"/>
        <EditText
            android:id="@+id/etEmail"
            style="@style/InputField"
            android:hint="e.g. student@mu.ac.zm"
            android:inputType="textEmailAddress"/>

        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_blue"
            android:text="Send OTP"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:elevation="0dp"/>
    </LinearLayout>

    <!-- Step 2: OTP & New Password (initially GONE) -->
    <LinearLayout
        android:id="@+id/layoutOtpStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/InputLabel" android:text="Enter 6-Digit OTP"/>
        <EditText
            android:id="@+id/etOtp"
            style="@style/InputField"
            android:hint="123456"
            android:inputType="number"
            android:maxLength="6"/>

        <TextView style="@style/InputLabel" android:text="New Password" android:layout_marginTop="12dp"/>
        <EditText
            android:id="@+id/etNewPassword"
            style="@style/InputField"
            android:hint="••••••••"
            android:inputType="textPassword"/>

        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_blue"
            android:text="Verify &amp; Reset Password"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:elevation="0dp"/>
    </LinearLayout>

</LinearLayout>
