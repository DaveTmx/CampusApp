<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout style="@style/SectionHeader">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Teaching Schedule" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="Upload the class timetable students see" android:textColor="#B9C6DA" android:textSize="13sp"/>
    </LinearLayout>

    <!-- Which programme's timetable is shown and edited below. -->
    <TextView style="@style/InputLabel"
        android:layout_marginStart="16dp" android:layout_marginTop="12dp"
        android:text="Programme"/>
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:background="@drawable/bg_input">
        <Spinner
            android:id="@+id/spScheduleProgram"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:paddingStart="6dp" android:paddingEnd="36dp"
            android:spinnerMode="dropdown"/>
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="end|center_vertical" android:layout_marginEnd="12dp"
            android:src="@drawable/ic_arrow_down" android:importantForAccessibility="no"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp">
        <Button
            android:id="@+id/btnAddClass"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_blue"
            app:backgroundTint="@null" android:text="Add class"
            android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold"/>
        <Button
            android:id="@+id/btnImportCsv"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_outline"
            app:backgroundTint="@null" android:text="Import CSV"
            android:textAllCaps="false" android:textColor="@color/text_dark"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout
            android:id="@+id/scheduleContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="16dp"/>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" android:id="@+id/bottomNavInclude"/>

</LinearLayout>
