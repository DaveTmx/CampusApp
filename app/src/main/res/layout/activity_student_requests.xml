<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout style="@style/SectionHeader">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Student Requests" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="Approve or reject group changes and number corrections" android:textColor="#B9C6DA" android:textSize="13sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnBackRequests"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginTop="12dp"
        android:text="Back" android:textAllCaps="false"/>

    <TextView
        android:id="@+id/tvRequestsStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="16dp"
        android:textColor="@color/text_gray" android:textSize="14sp"/>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/requestsContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp"/>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" android:id="@+id/bottomNavInclude"/>

</LinearLayout>
