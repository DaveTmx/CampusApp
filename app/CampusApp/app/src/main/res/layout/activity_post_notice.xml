<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_dark"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post a Notice"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:text="Publish an update for students"
            android:textColor="@color/text_gray"
            android:textSize="14sp"/>

        <TextView style="@style/InputLabel" android:layout_marginTop="0dp" android:text="Title"/>
        <EditText android:id="@+id/etTitle" style="@style/InputField" android:hint="e.g. Library Closed Saturday"/>

        <TextView style="@style/InputLabel" android:text="Category"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/catAcademic" style="@style/FilterChip"
                android:text="Academic" android:textColor="@color/white" android:background="@drawable/bg_pill_selected"/>
            <TextView android:id="@+id/catAdmin" style="@style/FilterChip" android:text="Admin"/>
            <TextView android:id="@+id/catUrgent" style="@style/FilterChip" android:text="Urgent"/>
        </LinearLayout>

        <TextView style="@style/InputLabel" android:text="Details"/>
        <EditText
            android:id="@+id/etBody"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="@color/text_dark"
            android:hint="What do students need to know?"
            android:textColorHint="@color/text_gray_light"/>

        <Button
            android:id="@+id/btnPost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_red"
            android:text="Post notice"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:elevation="0dp"/>

    </LinearLayout>
</ScrollView>
