<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_back"
        app:tint="@color/text_dark"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Log In"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="24dp"
        android:text="Access your student dashboard"
        android:textColor="@color/text_gray"
        android:textSize="14sp"/>

    <TextView style="@style/InputLabel" android:text="Student Number"/>
    <EditText style="@style/InputField" android:hint="e.g. 20241908" android:inputType="number"/>

    <TextView style="@style/InputLabel" android:text="Password"/>
    <EditText style="@style/InputField" android:hint="••••••••" android:inputType="textPassword"/>

    <Button
        android:id="@+id/btnLogIn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_blue"
        android:text="Log In"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:elevation="0dp"/>

    <TextView
        android:id="@+id/tvForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Forgot password?"
        android:textColor="@color/primary_blue"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tvRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:text="New student? Register"
        android:textColor="@color/primary_blue"
        android:textSize="14sp"/>

</LinearLayout>
