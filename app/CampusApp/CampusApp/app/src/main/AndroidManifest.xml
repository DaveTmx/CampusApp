<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusCompanion">

        <!-- Splash screen entry point (shows Campus Connect screen for 20 seconds) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Role selection activity -->
        <activity
            android:name=".ui.auth.RoleSelectActivity"
            android:exported="false" />

        <!-- Template activity kept from project creation (no longer the launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.StudentLoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.StudentRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.ResetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LecturerLoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.StudentHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.StudentScheduleActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.CampusMapActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.NoticesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.StudentProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.GroupChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.student.ReportIssueActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.LecturerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.LecturerScheduleActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.LecturerMapActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.LecturerNoticesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.LecturerAccountActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.PostNoticeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.StudentRosterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.EditStudentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.GroupsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.SyncStatusActivity"
            android:exported="false" />

    </application>

</manifest>
