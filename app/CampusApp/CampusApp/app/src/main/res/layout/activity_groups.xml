<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout style="@style/SectionHeader">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Groups" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="Mulungushi Course Allocations" android:textColor="#B9C6DA" android:textSize="13sp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <LinearLayout style="@style/NoticeCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Group G01" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_dark"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="Systems Analysis" android:textSize="13sp" android:textColor="@color/text_gray"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="15/15" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_dark"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:background="@drawable/bg_progress_track">
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_progress_fill_red"/>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout style="@style/NoticeCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Group G02" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_dark"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="Database Design" android:textSize="13sp" android:textColor="@color/text_gray"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="12/15" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_dark"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:background="@drawable/bg_progress_track">
                    <View android:layout_width="240dp" android:layout_height="match_parent" android:background="@drawable/bg_progress_fill_blue"/>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout style="@style/NoticeCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Group G03" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_dark"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="UI/UX Prototyping" android:textSize="13sp" android:textColor="@color/text_gray"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="8/15" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_dark"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:background="@drawable/bg_progress_track">
                    <View android:layout_width="160dp" android:layout_height="match_parent" android:background="@drawable/bg_progress_fill_navy"/>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout style="@style/NoticeCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Group G04" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_dark"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="Mobile Development" android:textSize="13sp" android:textColor="@color/text_gray"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="3/15" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_dark"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:background="@drawable/bg_progress_track">
                    <View android:layout_width="60dp" android:layout_height="match_parent" android:background="@drawable/bg_progress_fill_gray"/>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" android:id="@+id/bottomNavInclude"/>

</LinearLayout>
