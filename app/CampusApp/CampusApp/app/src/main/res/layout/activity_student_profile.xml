<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout style="@style/SectionHeader">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="My Profile" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="Mulungushi University Portal" android:textColor="#B9C6DA" android:textSize="13sp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:elevation="2dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Chileshe Banda" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/text_dark"/>
                        <TextView android:id="@+id/tvNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="Student No: 20241908" android:textSize="13sp" android:textColor="@color/text_gray"/>
                        <TextView android:id="@+id/tvProgramme" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="BSc in Computer Science" android:textSize="13sp" android:textColor="@color/text_gray"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="14dp" android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ASSIGNED GROUP" android:textSize="11sp" android:textColor="@color/text_gray" android:textStyle="bold"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_green" android:padding="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Group G02" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/text_dark"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="12 / 15 members • Systems Development" android:textSize="12sp" android:textColor="@color/text_gray"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Confirmed" android:textColor="@color/badge_green" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>

            </LinearLayout>

            <TextView android:id="@+id/tvEditProfile" style="@style/ProfileAction" android:text="Edit name / programme"/>
            <TextView android:id="@+id/tvGroupChange" style="@style/ProfileAction" android:text="Request group change"/>
            <TextView android:id="@+id/tvNumberCorrection" style="@style/ProfileAction" android:text="Request number correction"/>
            <TextView android:id="@+id/tvReportIssue" style="@style/ProfileAction" android:text="Report an issue"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_red"
                android:text="Log out"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:elevation="0dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Synced 5 min ago"
                android:textSize="12sp"
                android:textColor="@color/text_gray_light"/>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" android:id="@+id/bottomNavInclude"/>

</LinearLayout>
