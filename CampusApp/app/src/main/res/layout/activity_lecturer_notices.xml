<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout style="@style/SectionHeader">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Notices" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="Post updates for students" android:textColor="#B9C6DA" android:textSize="13sp"/>
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/noticesContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp"/>
        </ScrollView>

        <include layout="@layout/layout_bottom_nav" android:id="@+id/bottomNavInclude"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/fabAddNotice"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_above="@id/bottomNavInclude"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_fab"
        android:padding="16dp"
        android:src="@drawable/ic_add"
        android:elevation="6dp"/>

</RelativeLayout>
